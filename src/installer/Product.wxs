<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  
  <?define ProductName = "Local Vibe Coding Stack" ?>
  <?define ProductVersion = "1.0.0" ?>
  <?define Manufacturer = "Local Vibe" ?>
  <?define UpgradeCode = "12345678-1234-1234-1234-123456789012" ?>
  
  <Product Id="*" 
           Name="$(var.ProductName)" 
           Language="1033" 
           Version="$(var.ProductVersion)" 
           Manufacturer="$(var.Manufacturer)" 
           UpgradeCode="$(var.UpgradeCode)">
    
    <Package InstallerVersion="500" 
             Compressed="yes" 
             InstallScope="perUser"
             Description="Local AI Code Assistant Stack"
             Comments="Installs VS Code, Cline, LM Studio, and AI models" />

    <!-- Prevent downgrade -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    
    <!-- Embed cab in MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Check for minimum OS version (Windows 10) -->
    <Condition Message="This application requires Windows 10 or later.">
      <![CDATA[Installed OR (VersionNT >= 603)]]>
    </Condition>

    <!-- Check for PowerShell 5.1+ -->
    <Condition Message="This application requires PowerShell 5.1 or later.">
      <![CDATA[Installed OR POWERSHELLVERSION >= "5.1"]]>
    </Condition>

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="icon.ico" SourceFile="assets\icon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />
    
    <!-- Add/Remove Programs properties -->
    <Property Id="ARPHELPLINK" Value="https://github.com/yourusername/local-vibe-coding-stack" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/yourusername/local-vibe-coding-stack" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="yes" Secure="yes" />
    
    <!-- Check for PowerShell version -->
    <Property Id="POWERSHELLVERSION">
      <RegistrySearch Id="PowerShellVersion"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\PowerShell\3\PowerShellEngine"
                      Name="PowerShellVersion"
                      Type="raw" />
    </Property>

    <!-- Features -->
    <Feature Id="ProductFeature" 
             Title="Local Vibe Coding Stack" 
             Level="1"
             Description="Complete local AI coding assistant stack"
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">
      
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Installation directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="LocalVibeCodingStack">
          <Directory Id="ScriptsFolder" Name="scripts" />
          <Directory Id="AssetsFolder" Name="assets" />
          <Directory Id="LogsFolder" Name="logs" />
        </Directory>
      </Directory>
      
      <!-- Desktop shortcut -->
      <Directory Id="DesktopFolder" Name="Desktop" />
      
      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Local Vibe Coding Stack" />
      </Directory>
    </Directory>

    <!-- Component groups -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      
      <!-- Installation script -->
      <Component Id="InstallScript" Guid="11111111-1111-1111-1111-111111111111">
        <File Id="InstallPS1" 
              Source="scripts\install.ps1" 
              KeyPath="yes" 
              DiskId="1" />
      </Component>

      <!-- Uninstallation script -->
      <Component Id="UninstallScript" Guid="22222222-2222-2222-2222-222222222222">
        <File Id="UninstallPS1" 
              Source="scripts\uninstall.ps1" 
              KeyPath="yes" 
              DiskId="1" />
      </Component>

      <!-- Configuration file -->
      <Component Id="ConfigFile" Guid="33333333-3333-3333-3333-333333333333">
        <File Id="ConfigJSON" 
              Source="assets\installer-config.json" 
              KeyPath="yes" 
              DiskId="1" />
      </Component>

      <!-- README -->
      <Component Id="ReadmeFile" Guid="44444444-4444-4444-4444-444444444444">
        <File Id="ReadmeMD" 
              Source="README.md" 
              KeyPath="yes" 
              DiskId="1" />
      </Component>
    </ComponentGroup>

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="55555555-5555-5555-5555-555555555555">
        <Shortcut Id="DesktopShortcutId"
                  Name="Local Vibe Coding"
                  Description="Launch VS Code with Local AI Assistant"
                  Target="[LocalAppDataFolder]Programs\Microsoft VS Code\Code.exe"
                  WorkingDirectory="DesktopFolder"
                  Icon="icon.ico" />
        <RegistryValue Root="HKCU" 
                       Key="Software\LocalVibe\CodingStack" 
                       Name="DesktopShortcut" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes"/>
        <RemoveFolder Id="RemoveDesktopFolder" Directory="DesktopFolder" On="uninstall"/>
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="66666666-6666-6666-6666-666666666666">
        <Shortcut Id="StartMenuShortcutId"
                  Name="Local Vibe Coding Stack"
                  Description="Launch VS Code with Local AI Assistant"
                  Target="[LocalAppDataFolder]Programs\Microsoft VS Code\Code.exe"
                  WorkingDirectory="ProgramMenuFolder"
                  Icon="icon.ico" />
        <Shortcut Id="UninstallShortcutId"
                  Name="Uninstall Local Vibe Coding Stack"
                  Description="Uninstall the application"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" 
                       Key="Software\LocalVibe\CodingStack" 
                       Name="StartMenuShortcut" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Custom actions -->
    
    <!-- Run installation script after files are installed -->
    <CustomAction Id="RunInstallScript"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\install.ps1&quot; -ConfigPath &quot;[INSTALLFOLDER]assets\installer-config.json&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <!-- Run uninstallation script before uninstall -->
    <CustomAction Id="RunUninstallScript"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\uninstall.ps1&quot; -Force"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Set progress text -->
    <CustomAction Id="SetInstallProgressText" 
                  Property="ProgressText"
                  Value="Installing VS Code, Cline, LM Studio, and AI models. This may take 15-30 minutes..." />
    
    <CustomAction Id="SetUninstallProgressText" 
                  Property="ProgressText"
                  Value="Removing Local Vibe Coding Stack components..." />

    <!-- Installation sequence -->
    <InstallExecuteSequence>
      <!-- Install -->
      <Custom Action="SetInstallProgressText" After="InstallInitialize">NOT Installed</Custom>
      <Custom Action="RunInstallScript" Before="InstallFinalize">NOT Installed</Custom>
      
      <!-- Uninstall -->
      <Custom Action="SetUninstallProgressText" Before="RemoveFiles">REMOVE="ALL"</Custom>
      <Custom Action="RunUninstallScript" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- UI sequence for progress text -->
    <InstallUISequence>
      <Custom Action="SetInstallProgressText" After="CostFinalize">NOT Installed</Custom>
    </InstallUISequence>

    <!-- Use built-in UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    
    <!-- Custom welcome dialog text -->
    <WixVariable Id="WixUILicenseRtf" Value="assets\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\dialog.bmp" />

  </Product>
</Wix>
